const ctxMenu = document.getElementById('desktopContextMenu');
let activeSubmenu = null;
let submenuCloseTimer = null;
let lastContextPos = { x: 100, y: 100 };
let userCreatedCount = 0;

desktop.addEventListener('contextmenu', (e) => {
    if (e.target.closest('.icon') || e.target.closest('.window')) return;
    e.preventDefault();
    closeAllSubmenus();

    lastContextPos = { x: e.pageX, y: e.pageY };
    const pasteRow = document.getElementById('desktopPasteRow');
    if (pasteRow) pasteRow.classList.toggle('disabled', !(window.xpShell && xpShell.hasClipboard()));
    ctxMenu.style.display = 'block';

    let x = e.pageX;
    let y = e.pageY;

    if (x + ctxMenu.offsetWidth > window.innerWidth) {
        x = window.innerWidth - ctxMenu.offsetWidth - 4;
    }
    if (y + ctxMenu.offsetHeight > window.innerHeight - 30) {
        y = window.innerHeight - ctxMenu.offsetHeight - 34;
    }

    ctxMenu.style.left = x + 'px';
    ctxMenu.style.top = y + 'px';
});

document.addEventListener('click', (e) => {
    if (!ctxMenu.contains(e.target)) {
        ctxMenu.style.display = 'none';
        closeAllSubmenus();
    }
    if (!e.target.closest || !e.target.closest('.start-menu, .start-btn')) hideStartMenu();
    const bm = document.getElementById('bonziContextMenu');
    if (bm && !bm.contains(e.target)) bm.classList.remove('show');
});

document.querySelectorAll('.xp-menu-row[data-sub]').forEach(row => {
    row.addEventListener('mouseenter', () => {
        clearTimeout(submenuCloseTimer);
        const subId = row.getAttribute('data-sub');
        const sub = document.getElementById(subId);

        if (activeSubmenu && activeSubmenu !== sub) {
            activeSubmenu.style.display = 'none';
            activeSubmenu.parentElement.classList.remove('active');
        }

        if (sub) {
            sub.style.display = 'block';
            row.classList.add('active');
            activeSubmenu = sub;

            const subRect = sub.getBoundingClientRect();
            if (subRect.right > window.innerWidth) {
                sub.classList.add('open-left');
            } else {
                sub.classList.remove('open-left');
            }

            if (subRect.bottom > window.innerHeight - 30) {
                sub.classList.add('open-up');
            } else {
                sub.classList.remove('open-up');
            }
        }
    });

    row.addEventListener('mouseleave', (e) => {
        const subId = row.getAttribute('data-sub');
        const sub = document.getElementById(subId);
        if (sub && !sub.contains(e.relatedTarget)) {
            submenuCloseTimer = setTimeout(() => {
                sub.style.display = 'none';
                row.classList.remove('active');
                if (activeSubmenu === sub) activeSubmenu = null;
            }, 180);
        }
    });
});

document.querySelectorAll('.xp-submenu').forEach(sub => {
    sub.addEventListener('mouseenter', () => clearTimeout(submenuCloseTimer));
    sub.addEventListener('mouseleave', () => {
        submenuCloseTimer = setTimeout(() => {
            sub.style.display = 'none';
            sub.parentElement.classList.remove('active');
            if (activeSubmenu === sub) activeSubmenu = null;
        }, 180);
    });
});

function closeAllSubmenus() {
    document.querySelectorAll('.xp-submenu').forEach(s => s.style.display = 'none');
