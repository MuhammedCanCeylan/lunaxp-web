function pasteToDesktop() {
    const row = document.getElementById('desktopPasteRow');
    if (!window.xpShell || !xpShell.hasClipboard()) return;
    const result = xpShell.pasteInto(vfs.getSpecialFolderPath('desktop'));
    if (!result.ok && row) row.classList.add('disabled');
    ctxMenu.style.display = 'none';
    closeAllSubmenus();
    if (window.appRegistry) { appRegistry.renderDesktopIcons(); initDraggableIcons(); }
}

function createDesktopItem(type) {
    ctxMenu.style.display = 'none';
    closeAllSubmenus();
    if (!window.vfs) return;

    const desktopPath = vfs.getSpecialFolderPath('desktop');
    let wantedName = 'Yeni Klasör';
    let extra = {};

    if (type === 'folder') {
        wantedName = 'Yeni Klasör';
    } else if (type === 'txt') {
        wantedName = 'Yeni Metin Belgesi.txt';
        extra = { ext: 'txt', content: '', size: '0 B' };
    } else if (type === 'bmp') {
        wantedName = 'Yeni Bit Eşlem Resmi.bmp';
        extra = { ext: 'bmp', size: '0 B' };
    } else if (type === 'zip') {
        wantedName = 'Yeni Sıkıştırılmış Klasör.zip';
        extra = { ext: 'zip', size: '0 B' };
    }

    const created = type === 'folder'
        ? vfs.createFolder(desktopPath, wantedName)
        : vfs.createItem(desktopPath, wantedName, 'file', extra);
    if (!created) return;

    appRegistry.renderDesktopIcons();
    initDraggableIcons();

    const icon = document.getElementById('vfs-icon-' + created.id);
    if (icon) {
        const maxLeft = Math.max(0, desktop.clientWidth - 80);
        const maxTop = Math.max(0, desktop.clientHeight - 76);
        icon.style.left = Math.min(Math.max(lastContextPos.x, 0), maxLeft) + 'px';
        icon.style.top = Math.min(Math.max(lastContextPos.y, 0), maxTop) + 'px';
        appRegistry.saveDesktopIconPosition(icon.dataset.positionKey, icon.offsetLeft, icon.offsetTop);
        startInlineRename(icon, created.name);
    }
}

function startInlineRename(iconEl, currentName) {
    if (!iconEl) return;
    const label = iconEl.querySelector('.icon-label') || iconEl.querySelector('span');
    if (!label || iconEl.querySelector('.icon-rename-input')) return;
    const input = document.createElement('input');
    input.className = 'icon-rename-input';
    input.value = currentName;

    label.style.display = 'none';
    iconEl.appendChild(input);
    input.focus();
    input.select();
    let finished = false;

    function finishRename(commit) {
        if (finished) return;
        finished = true;
        const val = input.value.trim();
        if (commit && val && val !== currentName && iconEl.dataset.vfsPath && window.vfs) {
            const oldPath = iconEl.dataset.vfsPath;
            const parentPath = vfs.parentPath(oldPath);
            const oldName = vfs.basename(oldPath);
            if (vfs.renameItem(parentPath, oldName, val)) {
                appRegistry.renderDesktopIcons();
                initDraggableIcons();
                return;
            }
        }
        label.innerText = currentName;
        label.style.display = 'block';
        input.remove();
    }

    input.onblur = () => finishRename(true);
    input.onkeydown = (e) => {
        if (e.key === 'Enter') { e.preventDefault(); finishRename(true); }
        if (e.key === 'Escape') { e.preventDefault(); finishRename(false); }
    };
}

