function executeRunCommand() {
    const input = document.getElementById('runInput');
    const cmd = (input.value || '').trim();
    if (!cmd) return;
    const low = cmd.toLowerCase();
    const appAliases = {
        'notepad': 'notepad', 'notepad.exe': 'notepad',
        'mspaint': 'paint', 'mspaint.exe': 'paint', 'paint': 'paint',
        'calc': 'calculator', 'calc.exe': 'calculator',
        'iexplore': 'ie', 'iexplore.exe': 'ie',
        'winamp': 'winamp', 'winamp.exe': 'winamp',
        'explorer': 'explorer', 'explorer.exe': 'explorer'
    };
    if (appAliases[low]) {
        const app = appRegistry.get(appAliases[low]);
        if (app) windowManager.open(app);
        closeRunDialog();
        return;
    }
    if (low === 'control' || low === 'control.exe') {
        xpShell.openExplorer('Denetim Masası');
        closeRunDialog();
        return;
    }

    // XP project maintenance / shell paths.
    const shellCommands = {
        'appcheck': () => xpShell.openExplorer(vfs.getSpecialFolderPath('appcheck')),
        'shell:appcheck': () => xpShell.openExplorer(vfs.getSpecialFolderPath('appcheck')),
        'programs': () => xpShell.openExplorer(vfs.getSpecialFolderPath('programs')),
        'shell:programs': () => xpShell.openExplorer(vfs.getSpecialFolderPath('programs')),
        'desktop': () => xpShell.openExplorer(vfs.getSpecialFolderPath('desktop')),
        'shell:desktop': () => xpShell.openExplorer(vfs.getSpecialFolderPath('desktop')),
        'programfiles': () => xpShell.openExplorer(vfs.getSpecialFolderPath('programFiles')),
        'shell:programfiles': () => xpShell.openExplorer(vfs.getSpecialFolderPath('programFiles')),
        'c:': () => xpShell.openExplorer('C:\\')
    };
    if (shellCommands[low]) {
        shellCommands[low]();
        closeRunDialog();
        return;
    }

    // Allow Run to start any registered app by id, display title or executable file name.
    const registered = appRegistry.all().find(app => {
        const exe = appRegistry.executableNameFor ? appRegistry.executableNameFor(app).toLowerCase() : '';
        return app.id.toLowerCase() === low || app.title.toLowerCase() === low || exe === low;
    });
    if (registered) {
        xpShell.openApp(registered.id);
        closeRunDialog();
        return;
    }

    if (vfs && vfs.resolvePath(cmd)) {
        xpShell.openVfsItem(cmd);
        closeRunDialog();
        return;
    }
    closeRunDialog();
    showShellNotice('Çalıştır', "Windows '" + cmd + "' öğesini bulamıyor. Adı doğru yazdığınızdan emin olup yeniden deneyin.");
}

