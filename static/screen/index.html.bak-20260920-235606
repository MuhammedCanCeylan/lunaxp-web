<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Muhammed Can Ceylan - Windows XP Professional</title>
<link rel="stylesheet" href="./css/os-base.css">
<link rel="stylesheet" href="./css/windows.css">
<link rel="stylesheet" href="./apps/bonzi/clippy.js/build/clippy.css">

<style>
  /* ==================== MASAÜSTÜ SEÇİM ÇERÇEVESİ ==================== */
  #selectionBox {
    position: absolute;
    display: none;
    background: rgba(49, 106, 197, 0.35);
    border: 1px dotted #002e8a;
    z-index: 50;
    pointer-events: none;
  }

  /* ==================== GERÇEK WINDOWS XP LUNA SAĞ TIK MENÜSÜ ==================== */
  .xp-menu {
    position: fixed;
    background: #ffffff;
    border: 1px solid #716f64;
    box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.4);
    padding: 2px 1px;
    min-width: 170px;
    z-index: 250000;
    font-family: Tahoma, sans-serif;
    font-size: 11px;
    color: #000000;
    user-select: none;
    display: none;
  }

  .xp-menu-row {
    position: relative;
    display: flex;
    align-items: center;
    height: 22px;
    padding: 0 6px 0 4px;
    cursor: default;
  }

  .xp-menu-row:hover,
  .xp-menu-row.active {
    background: #316ac5;
    color: #ffffff;
  }

  .xp-menu-row.disabled {
    color: #8d8a7f;
    pointer-events: none;
  }

  .xp-menu-icon {
    width: 20px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-right: 6px;
  }

  .xp-menu-icon img {
    width: 16px;
    height: 16px;
    object-fit: contain;
  }

  .xp-menu-text {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .xp-menu-arrow {
    width: 0;
    height: 0;
    border-top: 3px solid transparent;
    border-bottom: 3px solid transparent;
    border-left: 4px solid #000000;
    margin-left: 14px;
    flex-shrink: 0;
  }

  .xp-menu-row:hover .xp-menu-arrow,
  .xp-menu-row.active .xp-menu-arrow {
    border-left-color: #ffffff;
  }

  .xp-menu-sep {
    height: 1px;
    background: #aca899;
    border-bottom: 1px solid #ffffff;
    margin: 3px 2px;
  }

  .xp-submenu {
    position: absolute;
    top: -3px;
    left: 100%;
    background: #ffffff;
    border: 1px solid #716f64;
    box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.4);
    padding: 2px 1px;
    min-width: 175px;
    display: none;
    z-index: 250001;
  }

  .xp-submenu.open-left {
    left: auto;
    right: 100%;
  }

  .xp-submenu.open-up {
    top: auto;
    bottom: -3px;
  }

  /* Masaüstü İsim Düzenleme (Inline Rename) */
  .icon-rename-input {
    width: 82px;
    font-size: 11px;
    font-family: Tahoma, sans-serif;
    text-align: center;
    border: 1px solid #000;
    outline: none;
    background: #fff;
    color: #000;
    padding: 1px 2px;
    z-index: 10;
  }

  /* ==================== SES DENETİMİ (POPUP) ==================== */
  #volumePopup {
    position: absolute;
    bottom: 32px;
    right: 85px;
    width: 78px;
    height: 168px;
    background: #ece9d8;
    border: 2px outset #ffffff;
    box-shadow: 2px 2px 6px rgba(0,0,0,0.5);
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 10px 4px 8px;
    z-index: 25000;
  }
  .vol-range-input {
    position: absolute;
    width: 90px;
    height: 28px;
    transform: rotate(-90deg);
    -webkit-appearance: none;
    background: transparent;
    cursor: pointer;
    margin: 0;
    outline: none;
    z-index: 5;
  }
  .vol-range-input::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 11px;
    height: 26px;
    border-radius: 1px;
    background: linear-gradient(to right, #1dbb1d 0%, #ece9d8 20%, #ffffff 50%, #b0b0b0 80%, #1dbb1d 100%);
    border: 1px solid #000;
    box-shadow: 1px 1px 2px rgba(0,0,0,0.4);
    cursor: pointer;
  }

  /* ==================== TARİH VE SAAT (TIMEDATE.CPL) ==================== */
  #dateTimeModal {
    position: fixed;
    width: 420px;
    height: 380px;
    background: #ece9d8;
    border: 3px solid #0055ea;
    border-radius: 6px 6px 0 0;
    box-shadow: 3px 5px 20px rgba(0,0,0,0.5);
    z-index: 300000;
    display: none;
    flex-direction: column;
    left: 50%;
    top: 45%;
    transform: translate(-50%, -50%);
  }
  .dt-tabs {
    display: flex;
    gap: 2px;
    border-bottom: 1px solid #999;
    padding-left: 8px;
    background: #ece9d8;
    padding-top: 6px;
  }
  .dt-tab {
    padding: 4px 10px;
    background: #ece9d8;
    border: 1px solid #999;
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    font-size: 11px;
    cursor: pointer;
  }
  .dt-tab.active {
    background: #fff;
    font-weight: bold;
    border-bottom: 1px solid #fff;
    margin-bottom: -1px;
  }
  .dt-body {
    flex: 1;
    padding: 12px;
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 11px;
  }
  .dt-row { display: flex; gap: 12px; }
  .dt-group {
    border: 1px solid #999;
    border-radius: 4px;
    padding: 10px;
    flex: 1;
    position: relative;
  }
  .dt-legend {
    position: absolute;
    top: -8px;
    left: 8px;
    background: #fff;
    padding: 0 4px;
    font-size: 11px;
    color: #003399;
  }
  .dt-calendar-table {
    width: 100%;
    border-collapse: collapse;
    text-align: center;
    font-size: 11px;
    margin-top: 6px;
  }
  .dt-calendar-table th { color: #555; padding: 2px; }
  .dt-calendar-table td { padding: 3px; cursor: pointer; }
  .dt-calendar-table td.today {
    outline: 1px solid #000;
    font-weight: bold;
    background: #cce4f7;
  }
  .dt-clock-canvas {
    width: 110px;
    height: 110px;
    display: block;
    margin: 0 auto;
  }
  .dt-btn-row {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    background: #ece9d8;
    padding: 8px 12px;
    border-top: 1px solid #ccc;
  }

  /* ==================== BONZI & MEMZ VIRÜS MOTORU ==================== */
  .bonzi-context-menu {
    position: fixed;
    background: #ece9d8;
    border: 2px outset #fff;
    padding: 2px;
    min-width: 170px;
    z-index: 200000;
    display: none;
    box-shadow: 3px 3px 8px rgba(0,0,0,0.4);
  }
  .bonzi-context-menu.show { display: block; }
  .bonzi-context-menu .menu-item {
    padding: 4px 18px 4px 8px;
    font-size: 11px;
    cursor: pointer;
    color: #000;
  }
  .bonzi-context-menu .menu-item:hover { background: #000080; color: #fff; }
  .bonzi-context-menu .menu-separator { height: 1px; background: #999; margin: 2px 0; }

  .bonzi-input-window {
    position: fixed;
    background: #ece9d8;
    border: 2px outset #fff;
    padding: 8px;
    z-index: 200000;
    display: none;
    box-shadow: 3px 3px 8px rgba(0,0,0,0.4);
    min-width: 280px;
  }
  .bonzi-input-window.show { display: block; }
  .bonzi-input-window .title-bar {
    background: #000080;
    color: #fff;
    font-size: 11px;
    font-weight: bold;
    padding: 3px 6px;
    margin: -8px -8px 8px -8px;
    display: flex;
    justify-content: space-between;
  }
  .bonzi-input-window textarea {
    width: 100%;
    height: 60px;
    font-size: 11px;
    font-family: Tahoma, sans-serif;
    border: 2px inset #fff;
    padding: 3px;
    resize: none;
  }
  .bonzi-input-window .btn-row {
    display: flex;
    gap: 4px;
    margin-top: 6px;
    justify-content: flex-end;
  }
  .bonzi-input-window .btn-row button {
    font-size: 11px;
    padding: 3px 10px;
    background: #ece9d8;
    border: 2px outset #fff;
    cursor: pointer;
  }

  #clippy, .clippy, [id^="clippy"], [class^="clippy"] { z-index: 99999 !important; }
  .clippy-balloon, .clippy-balloon * { z-index: 100000 !important; }

  .memz-error {
    position: fixed;
    width: 340px;
    height: 130px;
    background: #ece9d8;
    border: 3px solid #0055ea;
    border-radius: 6px 6px 0 0;
    box-shadow: 3px 5px 20px rgba(0,0,0,0.6);
    z-index: 999999;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .memz-header {
    background: linear-gradient(to bottom, #0058ee 0%, #3593ff 6%, #0058ee 14%, #0053ee 100%);
    padding: 3px 6px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: white;
    font-weight: bold;
    font-size: 11px;
    height: 24px;
  }
  .memz-content {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px;
    background: #fff;
    font-size: 11px;
  }
</style>
<link rel="stylesheet" href="./css/luna.css">
</head>
<body class="wall-bliss" id="bodyEl">

<!-- MASAÜSTÜ SEÇİM ÇERÇEVESİ -->
<div id="selectionBox"></div>

<!-- BOOT EKRANI -->
<div id="bootScreen">
    <div class="boot-logo">
        <svg style="width:46px;height:46px;" viewBox="0 0 40 40">
            <rect x="1" y="1" width="17" height="17" fill="#f25022"/>
            <rect x="21" y="1" width="17" height="17" fill="#7fba00"/>
            <rect x="1" y="21" width="17" height="17" fill="#00a4ef"/>
            <rect x="21" y="21" width="17" height="17" fill="#ffb900"/>
        </svg>
        <div class="boot-logo-text">Windows<b> xp</b></div>
    </div>
    <div class="boot-bar-track"><div class="boot-chunk"></div></div>
</div>

<!-- LOGIN EKRANI -->
<div id="loginScreen">
    <div class="login-top"><div class="xp-title">windows<b> xp</b></div></div>
    <div class="login-mid">
        <div style="font-size:14px; text-align:right;">Devam etmek için<br>hesabınızı tıklatın</div>
        <div class="login-divider"></div>
        <div class="user-tile" onclick="doLogin()">
            <img id="userAvatar" style="width:72px!important; height:72px!important; border-radius:6px; border:2px solid #fff; object-fit:cover; background:#333;" src="./profil.jpg" onerror="this.onerror=null; this.src='./icons/user_computer-0.png';" alt="Kullanıcı">
            <div class="user-tile-name">Muhammed Can Ceylan</div>
            <div style="font-size:11px; opacity:.8;">Yönetici</div>
        </div>
    </div>
</div>

<!-- SHUTDOWN EKRANI -->
<div id="shutdownScreen">
    <svg style="width:50px;height:50px;" viewBox="0 0 40 40">
        <rect x="1" y="1" width="17" height="17" fill="#f25022"/>
        <rect x="21" y="1" width="17" height="17" fill="#7fba00"/>
        <rect x="1" y="21" width="17" height="17" fill="#00a4ef"/>
        <rect x="21" y="21" width="17" height="17" fill="#ffb900"/>
    </svg>
    <div class="shutdown-msg" id="shutdownText">Windows kapatılıyor...</div>
    <button class="shutdown-btn" id="restartBtn" style="display:none;" onclick="restartDesktop()">Yeniden Başlat</button>
</div>

<!-- MASAÜSTÜ KANVASI -->
<div class="desktop" id="desktop"></div>

<!-- ==================== HİYERARŞİK MASAÜSTÜ SAĞ TIK MENÜSÜ ==================== -->
<div id="desktopContextMenu" class="xp-menu">
    <!-- Görünüm -->
    <div class="xp-menu-row" data-sub="subView">
        <span class="xp-menu-icon"></span>
        <span class="xp-menu-text">Görünüm</span>
        <span class="xp-menu-arrow"></span>
        <div class="xp-submenu" id="subView">
            <div class="xp-menu-row" onclick="arrangeIcons()">
                <span class="xp-menu-icon"></span>
                <span class="xp-menu-text">Simgeleri Otomatik Düzenle</span>
            </div>
            <div class="xp-menu-row" onclick="toggleDesktopIcons()">
                <span class="xp-menu-icon">✓</span>
                <span class="xp-menu-text">Masaüstü Öğelerini Göster</span>
            </div>
        </div>
    </div>

    <!-- Sıralama Ölçütü -->
    <div class="xp-menu-row" data-sub="subSort">
        <span class="xp-menu-icon"></span>
        <span class="xp-menu-text">Sıralama Ölçütü</span>
        <span class="xp-menu-arrow"></span>
        <div class="xp-submenu" id="subSort">
            <div class="xp-menu-row" onclick="arrangeIcons()">
                <span class="xp-menu-icon"></span>
                <span class="xp-menu-text">Ad</span>
            </div>
            <div class="xp-menu-row" onclick="arrangeIcons()">
                <span class="xp-menu-icon"></span>
                <span class="xp-menu-text">Tür</span>
            </div>
        </div>
    </div>

    <!-- Yenile -->
    <div class="xp-menu-row" onclick="refreshDesktop()">
        <span class="xp-menu-icon"></span>
        <span class="xp-menu-text">Yenile</span>
    </div>

    <div class="xp-menu-sep"></div>

    <div class="xp-menu-row disabled" id="desktopPasteRow" onclick="pasteToDesktop()">
        <span class="xp-menu-icon"></span>
        <span class="xp-menu-text">Yapıştır</span>
    </div>
    <div class="xp-menu-row disabled">
        <span class="xp-menu-icon"></span>
        <span class="xp-menu-text">Kısayol Yapıştır</span>
    </div>

    <div class="xp-menu-sep"></div>

    <!-- Yeni -->
    <div class="xp-menu-row" data-sub="subNew">
        <span class="xp-menu-icon"></span>
        <span class="xp-menu-text">Yeni</span>
        <span class="xp-menu-arrow"></span>
        <div class="xp-submenu" id="subNew">
            <div class="xp-menu-row" onclick="createDesktopItem('folder')">
                <span class="xp-menu-icon"><img src="./icons/directory_closed-4.png" onerror="this.onerror=null; this.src='./icons/windows-0.png';"></span>
                <span class="xp-menu-text">Klasör</span>
            </div>
            <div class="xp-menu-row disabled">
                <span class="xp-menu-icon"><img src="./icons/windows-0.png" onerror="this.onerror=null; this.src='';"></span>
                <span class="xp-menu-text">Kısayol</span>
            </div>
            <div class="xp-menu-sep"></div>
            <div class="xp-menu-row" onclick="createDesktopItem('bmp')">
                <span class="xp-menu-icon"><img src="./icons/paint_file-3.png" onerror="this.onerror=null; this.src='./icons/windows-0.png';"></span>
                <span class="xp-menu-text">Bit Eşlem Resmi</span>
            </div>
            <div class="xp-menu-row" onclick="createDesktopItem('txt')">
                <span class="xp-menu-icon"><img src="./icons/notepad-0.png" onerror="this.onerror=null; this.src='./icons/windows-0.png';"></span>
                <span class="xp-menu-text">Metin Belgesi</span>
            </div>
            <div class="xp-menu-row" onclick="createDesktopItem('zip')">
                <span class="xp-menu-icon"><img src="./icons/windows-0.png" onerror="this.onerror=null; this.src='./icons/windows-0.png';"></span>
                <span class="xp-menu-text">WinRAR ZIP Arşivi</span>
            </div>
        </div>
    </div>

    <div class="xp-menu-sep"></div>

    <!-- Windows XP: Masaüstü sağ tık -> Görüntü Özellikleri -->
    <div class="xp-menu-row" onclick="openDisplayProperties()">
        <span class="xp-menu-icon"></span>
        <span class="xp-menu-text">Özellikler</span>
    </div>
</div>

<!-- BAŞLAT MENÜSÜ -->
<div id="startMenu" class="start-menu">
    <div class="start-header">
        <img class="start-user-picture" src="./profil.jpg" onerror="this.onerror=null; this.src='./icons/user_computer-0.png';" alt="User">
        <span>Muhammed Can Ceylan</span>
    </div>
    <div class="start-body">
        <div class="start-left">
            <div id="startMenuApps" class="start-menu-apps"></div>
            <div class="start-all-programs" onclick="toggleAllProgramsMenu(event)">
                <span>Tüm Programlar</span><span class="start-programs-arrow">▶</span>
            </div>
        </div>
        <div class="start-right">
            <div class="start-place strong" onclick="xpShell.openExplorer(vfs.getSpecialFolderPath('documents')); hideStartMenu();">
                <img src="./icons/directory_open_file_mydocs-4.png" alt=""><span>Belgelerim</span>
            </div>
            <div class="start-place strong" onclick="xpShell.openExplorer(vfs.getSpecialFolderPath('pictures')); hideStartMenu();">
                <img src="./icons/paint_file-3.png" alt=""><span>Resimlerim</span>
            </div>
            <div class="start-place strong" onclick="xpShell.openExplorer(vfs.getSpecialFolderPath('music')); hideStartMenu();">
                <img src="./icons/cd_audio_cd_a-4.png" alt=""><span>Müziğim</span>
            </div>
            <div class="start-place strong" onclick="xpShell.openExplorer('Bilgisayarım'); hideStartMenu();">
                <img src="./icons/computer_explorer-4.png" alt=""><span>Bilgisayarım</span>
            </div>
            <div class="start-right-separator"></div>
            <div class="start-place" onclick="xpShell.openExplorer('Denetim Masası'); hideStartMenu();">
                <img src="./icons/windows-0.png" onerror="this.onerror=null;this.src='./icons/computer_explorer-4.png'" alt=""><span>Denetim Masası</span>
            </div>
            <div class="start-right-separator"></div>
            <div class="start-place" onclick="openHelpCenter();">
                <img src="./icons/user_computer-0.png" onerror="this.onerror=null;this.src='./icons/windows-0.png'" alt=""><span>Yardım ve Destek</span>
            </div>
            <div class="start-place" onclick="openSearchDialog();">
                <img src="./icons/computer_explorer-4.png" onerror="this.onerror=null;this.src='./icons/windows-0.png'" alt=""><span>Ara</span>
            </div>
            <div class="start-place" onclick="openRunDialog();">
                <img src="./icons/console_prompt-0.png" onerror="this.onerror=null;this.src='./icons/windows-0.png'" alt=""><span>Çalıştır...</span>
            </div>
        </div>
        <div id="allProgramsMenu" class="all-programs-menu"></div>
    </div>
    <div class="start-footer">
        <div class="start-footer-btn logoff" onclick="logOffUser();">
            <span class="start-footer-icon logoff-icon">↪</span><span>Oturumu Kapat</span>
        </div>
        <div class="start-footer-btn shutdown" onclick="executeShutdown()">
            <span class="start-footer-icon shutdown-icon">⏻</span><span>Bilgisayarı Kapat</span>
        </div>
    </div>
</div>

<div id="shellNotice" class="shell-notice" aria-hidden="true">
    <div class="shell-notice-window">
        <div class="shell-notice-title"><span id="shellNoticeTitle">Windows</span><button onclick="closeShellNotice()">×</button></div>
        <div class="shell-notice-body"><img src="./icons/windows-0.png" alt=""><span id="shellNoticeText"></span></div>
        <div class="shell-notice-actions"><button class="xp-shell-button" onclick="closeShellNotice()">Tamam</button></div>
    </div>
</div>

<div id="runDialog" class="run-dialog" aria-hidden="true">
    <div class="run-window">
        <div class="run-title"><span>Çalıştır</span><button onclick="closeRunDialog()">×</button></div>
        <div class="run-body">
            <img src="./icons/windows-0.png" alt="">
            <div class="run-copy">
                <p>Açmak istediğiniz program, klasör, belge veya Internet kaynağının adını yazın.</p>
                <div class="run-row"><label for="runInput">Aç:</label><input id="runInput" type="text" autocomplete="off" spellcheck="false"></div>
            </div>
        </div>
        <div class="run-actions"><button class="xp-shell-button default" onclick="executeRunCommand()">Tamam</button><button class="xp-shell-button" onclick="closeRunDialog()">İptal</button></div>
    </div>
</div>

<div id="helpCenter" class="xp-shell-panel" aria-hidden="true">
    <div class="xp-shell-panel-window help-window">
        <div class="xp-shell-panel-title"><span>Yardım ve Destek Merkezi</span><button onclick="closeHelpCenter()">×</button></div>
        <div class="help-body">
            <div class="help-banner"><span class="help-large-icon" aria-hidden="true">?</span><div><b>Windows XP Professional</b><span>Bir konu seçin.</span></div></div>
            <div class="help-grid">
                <button onclick="showHelpTopic('Dosya ve klasörler','Bilgisayarım içinde klasör açabilir, Yeni Klasör veya Yeni Metin Belgesi oluşturabilir; Ctrl+C, Ctrl+X ve Ctrl+V ile öğeleri kopyalayıp taşıyabilirsiniz.')">Dosya ve klasörler</button>
                <button onclick="showHelpTopic('Masaüstü','Masaüstü simgelerini sürükleyebilir, F2 ile yeniden adlandırabilir, Delete ile Geri Dönüşüm Kutusu’na gönderebilirsiniz.')">Masaüstü</button>
                <button onclick="showHelpTopic('Pencereler','Alt+Tab ile pencereler arasında geçiş yapın. Alt+Space pencere sistem menüsünü açar. Alt+F4 etkin pencereyi kapatır.')">Pencereler</button>
                <button onclick="showHelpTopic('Çalıştır','Başlat > Çalıştır üzerinden notepad, calc, mspaint, explorer ve kurulu diğer programların komutlarını kullanabilirsiniz.')">Çalıştır</button>
            </div>
            <div id="helpTopic" class="help-topic">Bir yardım konusu seçin.</div>
        </div>
    </div>
</div>

<!-- AĞ BAĞLANTISI DURUMU -->
<div id="networkPopup">
    <div class="network-popup-title">Yerel Ağ Bağlantısı Durumu</div>
    <div class="network-popup-body">
        <div class="network-status-icon"><span></span><span></span></div>
