function initRealDateTime() {
    const now = new Date();
    document.getElementById('dtMonthSelect').value = now.getMonth();
    document.getElementById('dtYearInput').value = now.getFullYear();
    renderCalendar();
    drawAnalogClock();
}

function renderCalendar() {
    const month = parseInt(document.getElementById('dtMonthSelect').value);
    const year = parseInt(document.getElementById('dtYearInput').value);
    const firstDay = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    const tbody = document.getElementById('dtCalendarBody');
    tbody.innerHTML = '';
    
    let date = 1;
    for (let i = 0; i < 6; i++) {
        const row = document.createElement('tr');
        for (let j = 0; j < 7; j++) {
            const cell = document.createElement('td');
            if (i === 0 && j < firstDay) {
                cell.innerText = '';
            } else if (date > daysInMonth) {
                break;
            } else {
                cell.innerText = date;
                const realToday = new Date();
                if (date === realToday.getDate() && month === realToday.getMonth() && year === realToday.getFullYear()) {
                    cell.className = 'today';
                }
                date++;
            }
            row.appendChild(cell);
        }
        tbody.appendChild(row);
        if (date > daysInMonth) break;
    }
}

function drawAnalogClock() {
    const canvas = document.getElementById('analogClockCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const radius = canvas.height / 2;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    ctx.beginPath();
    ctx.arc(radius, radius, radius - 4, 0, 2 * Math.PI);
    ctx.fillStyle = '#fff'; ctx.fill();
    ctx.strokeStyle = '#808080'; ctx.lineWidth = 2; ctx.stroke();
    
    for (let i = 0; i < 12; i++) {
        const angle = (i * Math.PI) / 6;
        ctx.beginPath();
        ctx.moveTo(radius + Math.cos(angle) * (radius - 10), radius + Math.sin(angle) * (radius - 10));
        ctx.lineTo(radius + Math.cos(angle) * (radius - 4), radius + Math.sin(angle) * (radius - 4));
        ctx.strokeStyle = '#333'; ctx.lineWidth = 1.5; ctx.stroke();
    }
    
    const now = new Date();
    const hr = now.getHours() % 12, min = now.getMinutes(), sec = now.getSeconds();
    
    drawHand(ctx, radius, radius, (hr * Math.PI)/6 + (min * Math.PI)/(6 * 60), radius * 0.48, 3, '#000');
    drawHand(ctx, radius, radius, (min * Math.PI)/30 + (sec * Math.PI)/(30 * 60), radius * 0.72, 2, '#000');
    drawHand(ctx, radius, radius, (sec * Math.PI)/30, radius * 0.82, 1, '#d00000');
    
    document.getElementById('dtDigitalTime').value = now.toLocaleTimeString();
    
}

function drawHand(ctx, cx, cy, angle, length, width, color) {
    ctx.beginPath();
    ctx.lineWidth = width; ctx.lineCap = 'round'; ctx.strokeStyle = color;
    ctx.moveTo(cx, cy);
    ctx.lineTo(cx + Math.sin(angle) * length, cy - Math.cos(angle) * length);
    ctx.stroke();
}
setInterval(drawAnalogClock, 1000);

/* =========================================================
   MASAÜSTÜ: SÜRÜKLEME & SEÇİM DİKDÖRTGENİ (MARQUEE)
   ========================================================= */
const desktop = document.getElementById('desktop');
const box = document.getElementById('selectionBox');
let isSelecting = false, startX = 0, startY = 0;

desktop.addEventListener('mousedown', function(e) {
    if (e.target.closest('.icon') || e.target.closest('.window') || e.target.closest('.xp-menu')) return;
    document.querySelectorAll('.icon').forEach(i => i.classList.remove('selected'));
    isSelecting = true;
    startX = e.clientX;
    startY = e.clientY;
    box.style.left = startX + 'px';
    box.style.top = startY + 'px';
    box.style.width = '0px';
    box.style.height = '0px';
    box.style.display = 'block';

    function onMove(ev) {
        if (!isSelecting) return;
        const left = Math.min(startX, ev.clientX);
        const top = Math.min(startY, ev.clientY);
        const width = Math.abs(ev.clientX - startX);
        const height = Math.abs(ev.clientY - startY);

        box.style.left = left + 'px';
        box.style.top = top + 'px';
        box.style.width = width + 'px';
        box.style.height = height + 'px';

        document.querySelectorAll('.icon').forEach(icon => {
            const r = icon.getBoundingClientRect();
            if (r.left < left + width && r.right > left && r.top < top + height && r.bottom > top) {
                icon.classList.add('selected');
            } else {
                icon.classList.remove('selected');
            }
        });
    }

    function onUp() {
        isSelecting = false;
        box.style.display = 'none';
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
    }

    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onUp);
});

function initDraggableIcons() {
    document.querySelectorAll('.icon').forEach(icon => {
        icon.onmousedown = function(e) {
            e.stopPropagation();
            if (e.target.tagName === 'INPUT' || e.button !== 0) return;

            const wasSelected = icon.classList.contains('selected');
            if (e.ctrlKey) {
                icon.classList.toggle('selected');
                if (!icon.classList.contains('selected')) return;
            } else if (!wasSelected) {
                document.querySelectorAll('.icon').forEach(i => i.classList.remove('selected', 'drop-target'));
                icon.classList.add('selected');
            } else {
                document.querySelectorAll('.icon').forEach(i => i.classList.remove('drop-target'));
            }

            const selectedVfsIcons = () => Array.from(document.querySelectorAll('.icon.selected[data-vfs-path]'));
            let startDragX = e.clientX, startDragY = e.clientY;
            let lastX = e.clientX, lastY = e.clientY;
            let iconX = icon.offsetLeft, iconY = icon.offsetTop;
            let moved = false;
            let dropTarget = null;

            function findFolderTarget(x, y) {
                if (!icon.dataset.vfsPath) return null;
                const selected = new Set(selectedVfsIcons());
                const candidates = Array.from(document.querySelectorAll('.icon[data-vfs-type="folder"]'))
                    .filter(other => other !== icon && !selected.has(other));
                return candidates.find(other => {
                    const r = other.getBoundingClientRect();
                    return x >= r.left && x <= r.right && y >= r.top && y <= r.bottom;
                }) || null;
            }

            function onDrag(ev) {
                lastX = ev.clientX; lastY = ev.clientY;
                if (Math.abs(ev.clientX - startDragX) > 3 || Math.abs(ev.clientY - startDragY) > 3) moved = true;
                if (!moved) return;
                icon.style.left = (iconX + ev.clientX - startDragX) + 'px';
                icon.style.top = (iconY + ev.clientY - startDragY) + 'px';
                const nextTarget = findFolderTarget(lastX, lastY);
                if (dropTarget !== nextTarget) {
                    if (dropTarget) dropTarget.classList.remove('drop-target');
                    dropTarget = nextTarget;
                    if (dropTarget) dropTarget.classList.add('drop-target');
                }
            }

            function onStop() {
                if (dropTarget) dropTarget.classList.remove('drop-target');
                if (moved && dropTarget && icon.dataset.vfsPath && dropTarget.dataset.vfsPath && window.vfs) {
                    const paths = selectedVfsIcons().map(el => el.dataset.vfsPath).filter(Boolean);
                    let changed = false;
                    paths.forEach(path => { if (vfs.movePath(path, dropTarget.dataset.vfsPath)) changed = true; });
                    if (changed) {
                        appRegistry.renderDesktopIcons();
                        initDraggableIcons();
                        document.removeEventListener('mousemove', onDrag);
                        document.removeEventListener('mouseup', onStop);
                        return;
                    }
                }
                if (moved) {
                    const gridX = 92, gridY = 88, baseX = 16, baseY = 16;
                    const maxLeft = Math.max(0, desktop.clientWidth - 80);
                    const maxTop = Math.max(0, desktop.clientHeight - 76);
                    const snappedLeft = Math.min(maxLeft, Math.max(0, baseX + Math.round((icon.offsetLeft - baseX) / gridX) * gridX));
                    const snappedTop = Math.min(maxTop, Math.max(0, baseY + Math.round((icon.offsetTop - baseY) / gridY) * gridY));
                    icon.style.left = snappedLeft + 'px';
                    icon.style.top = snappedTop + 'px';
                    if (icon.dataset.positionKey && window.appRegistry && window.appRegistry.saveDesktopIconPosition) {
                        window.appRegistry.saveDesktopIconPosition(icon.dataset.positionKey, snappedLeft, snappedTop);
                    }
                }
                document.removeEventListener('mousemove', onDrag);
                document.removeEventListener('mouseup', onStop);
            }

            document.addEventListener('mousemove', onDrag);
            document.addEventListener('mouseup', onStop);
        };
    });
}

function arrangeIcons() {
    if (ctxMenu) ctxMenu.style.display = 'none';
    closeAllSubmenus();
    if (window.appRegistry && window.appRegistry.clearDesktopIconPositions) {
        window.appRegistry.clearDesktopIconPositions();
    }
    window.appRegistry.renderDesktopIcons();
    initDraggableIcons();
}

